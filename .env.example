DATABASE_URL=postgresql://portale:portale@localhost:5432/portale
PORT=3000
# production = SMTP vero (se SMTP_HOST è impostato); altrimenti le mail restano in un trasporto finto
NODE_ENV=development
# Indirizzo pubblico del sito (messo nella mail di apertura iscrizioni)
SITE_URL=

# SMTP (per le tre mail: codice personale, recupero password, apertura iscrizioni)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dominio e-mail degli allievi (es. studenti.edu.ti.ch)
SCHOOL_DOMAIN=studenti.edu.ti.ch

# Limiti fornitore SMTP (invio apertura iscrizioni a lotti, copia nascosta)
# MAIL_BATCH_SIZE = destinatari per mail, MAIL_DAILY_LIMIT = destinatari al giorno
MAIL_BATCH_SIZE=50
MAIL_DAILY_LIMIT=500

# Responsabile sito iniziale (creato al primo avvio, password da impostare con il recupero password)
ADMIN_LOGIN_ID=admin@samtrevano.ch
